{
  "name": "video-kit",
  "version": "1.0.1",
  "description": "一条命令把 GitHub 仓库或抖音视频变成竖屏讲解视频",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "node --check tools/make-video.mjs && node --check tools/film-template.js && node --check tools/extract-content.mjs",
    "test": "python -m pytest tests/ -q",
    "links": "python tools/check-links.py",
    "history": "python tools/scan-history.py",
    "audit": "python -m pip_audit -r requirements.txt",
    "fonts": "python engine/get_fonts.py",
    "selfcheck": "npm run check && npm run lint && npm test && npm run links && npm run history",
    "demo": "node tools/make-video.mjs --repo https://github.com/achun1107/video-kit --out ./out",
    "vrt": "python tests/vrt.py",
    "vrt:update": "python tests/vrt.py --update",
    "lint": "python -m ruff check .",
    "lint:fix": "python -m ruff check . --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "video-generation",
    "canvas",
    "playwright",
    "ffmpeg",
    "tts",
    "douyin",
    "pipeline"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/achun1107/video-kit.git"
  }
}
